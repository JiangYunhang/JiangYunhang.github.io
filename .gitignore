# ============================================================
#  .gitignore — 不提交到 GitHub 的文件
# ============================================================

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 编辑器 / IDE ----
.idea/
.vscode/
.cursor/
*.swp

# ---- 依赖与构建产物 ----
node_modules/
_site/
.jekyll-cache/
.cache/

# ---- 音频（体积大；如需放歌请删掉下面两行）----
*.mp3
*.wav

# ============================================================
#  本地私有材料 —— 不要发布到公开仓库
# ============================================================
研究项目/
港中深实习证明.docx
Academic_CV_SJTU.docx
_cv_extract.txt
_internship_extract.txt
_chip_extract.txt
_moe_extract.txt
_sjtu_extract.txt
debug-*.log
_dom_dump.html
_audit_render.py
_check_ids.py
_verify_serve.py
_live_*.html
_final_*.html
_final_*.js
_final_*.css
_upload_to_github/
JiangYunhang.github.io-publish.zip

# ---- 根目录零散文件（assets/ 下的图片正常提交）----
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# ---- 本地临时文件 ----
*.log
*.tmp
*.bak
